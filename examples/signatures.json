{
  "rules": [
    {
      "id": "jwt",
      "kind": "secret",
      "label": "JWT Token",
      "pattern": "(?:^|[^A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}(?![A-Za-z0-9_-])",
      "flags": ""
    },
    {
      "id": "graphql-endpoint",
      "kind": "endpoint",
      "label": "GraphQL Endpoint",
      "pattern": "(?:^|[/?#])graphql(?:[/?#]|$)",
      "flags": "i"
    }
  ]
}
